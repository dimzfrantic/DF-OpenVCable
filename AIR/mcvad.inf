[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=11/25/2026,1.0.0.8
CatalogFile=mcvad.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13 ; Driver Store Directory

[SourceDisksNames]
1 = %DiskDescription%,,,

[SourceDisksFiles]
mcvad.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64,NTarm64

[Standard.NTamd64]
%DeviceDesc% = MCVAD_Device, ROOT\MCVAD

[Standard.NTarm64]
%DeviceDesc% = MCVAD_Device, ROOT\MCVAD

[MCVAD_Device.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=MCVAD_Device.CopyFiles
AddReg=MCVAD_Device.AddReg

[MCVAD_Device.CopyFiles]
mcvad.sys

[MCVAD_Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,mcvad.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

; Registrasi MediaCategories untuk penamaan pin bridge di Sound Control Panel
;
; Dua lokasi ditulis:
;  1. HKLM\SYSTEM\CurrentControlSet\Control\MediaCategories  (key global, cara lama)
;  2. HKR\MediaCategories                                    (software key device)
;
; Sejak Windows 10 1809 KS membaca software key device LEBIH DULU, dan key global
; dinyatakan deprecated. Tanpa entri di (2), nama endpoint bisa jatuh ke default
; form factor ("Speakers") walaupun key global ada.
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_A_RENDER%,Name,,%CableA.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_A_RENDER%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_A_CAPTURE%,Name,,%CableA.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_A_CAPTURE%,Display,1,00,00,00,00

HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_B_RENDER%,Name,,%CableB.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_B_RENDER%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_B_CAPTURE%,Name,,%CableB.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_B_CAPTURE%,Display,1,00,00,00,00

HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_C_RENDER%,Name,,%CableC.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_C_RENDER%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_C_CAPTURE%,Name,,%CableC.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_C_CAPTURE%,Display,1,00,00,00,00

HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_D_RENDER%,Name,,%CableD.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_D_RENDER%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_D_CAPTURE%,Name,,%CableD.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_D_CAPTURE%,Display,1,00,00,00,00

HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_E_RENDER%,Name,,%CableE.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_E_RENDER%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_E_CAPTURE%,Name,,%CableE.Desc%
HKLM,%MediaCategories%\%PINNAME_MCVAD_CABLE_E_CAPTURE%,Display,1,00,00,00,00

; Salinan di software key device (dibaca lebih dulu oleh KS sejak Windows 10 1809)
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_A_RENDER%,Name,,%CableA.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_A_CAPTURE%,Name,,%CableA.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_B_RENDER%,Name,,%CableB.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_B_CAPTURE%,Name,,%CableB.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_C_RENDER%,Name,,%CableC.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_C_CAPTURE%,Name,,%CableC.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_D_RENDER%,Name,,%CableD.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_D_CAPTURE%,Name,,%CableD.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_E_RENDER%,Name,,%CableE.Desc%
HKR,MediaCategories\%PINNAME_MCVAD_CABLE_E_CAPTURE%,Name,,%CableE.Desc%

[MCVAD_Device.NT.Interfaces]
; Satu kabel = SATU device interface audio.
;
; Aturan (Microsoft, "Installing Device Interfaces for an Audio Adapter"):
;   KSCATEGORY_AUDIO    -> reference string subdevice Wave (host streaming)
;   KSCATEGORY_RENDER   -> reference string subdevice Wave
;   KSCATEGORY_CAPTURE  -> reference string subdevice Wave
;   KSCATEGORY_TOPOLOGY -> reference string subdevice Topology
;
; JANGAN menambahkan KSCATEGORY_AUDIO untuk subdevice Topology ("CableX_Topo").
; AudioEndpointBuilder menghitung setiap interface KSCATEGORY_AUDIO sebagai satu
; "audio device", lalu membuat endpoint dari bridge pin topology untuk masing-masing.
; Mendaftarkan Wave + Topology sebagai KSCATEGORY_AUDIO membuat setiap kabel muncul
; DUA KALI di Sound Settings (10 endpoint render + 10 capture, seharusnya 5 + 5).

; Cable A
AddInterface=%KSCATEGORY_AUDIO%,"CableA",MCVAD.Interface.CableA
AddInterface=%KSCATEGORY_RENDER%,"CableA",MCVAD.Interface.CableA
AddInterface=%KSCATEGORY_CAPTURE%,"CableA",MCVAD.Interface.CableA
AddInterface=%KSCATEGORY_REALTIME%,"CableA",MCVAD.Interface.CableA
AddInterface=%KSCATEGORY_TOPOLOGY%,"CableA_Topo_v2",MCVAD.Interface.CableA_Topo

; Cable B
AddInterface=%KSCATEGORY_AUDIO%,"CableB",MCVAD.Interface.CableB
AddInterface=%KSCATEGORY_RENDER%,"CableB",MCVAD.Interface.CableB
AddInterface=%KSCATEGORY_CAPTURE%,"CableB",MCVAD.Interface.CableB
AddInterface=%KSCATEGORY_REALTIME%,"CableB",MCVAD.Interface.CableB
AddInterface=%KSCATEGORY_TOPOLOGY%,"CableB_Topo_v2",MCVAD.Interface.CableB_Topo

; Cable C
AddInterface=%KSCATEGORY_AUDIO%,"CableC",MCVAD.Interface.CableC
AddInterface=%KSCATEGORY_RENDER%,"CableC",MCVAD.Interface.CableC
AddInterface=%KSCATEGORY_CAPTURE%,"CableC",MCVAD.Interface.CableC
AddInterface=%KSCATEGORY_REALTIME%,"CableC",MCVAD.Interface.CableC
AddInterface=%KSCATEGORY_TOPOLOGY%,"CableC_Topo_v2",MCVAD.Interface.CableC_Topo

; Cable D
AddInterface=%KSCATEGORY_AUDIO%,"CableD",MCVAD.Interface.CableD
AddInterface=%KSCATEGORY_RENDER%,"CableD",MCVAD.Interface.CableD
AddInterface=%KSCATEGORY_CAPTURE%,"CableD",MCVAD.Interface.CableD
AddInterface=%KSCATEGORY_REALTIME%,"CableD",MCVAD.Interface.CableD
AddInterface=%KSCATEGORY_TOPOLOGY%,"CableD_Topo_v2",MCVAD.Interface.CableD_Topo

; Cable E
AddInterface=%KSCATEGORY_AUDIO%,"CableE",MCVAD.Interface.CableE
AddInterface=%KSCATEGORY_RENDER%,"CableE",MCVAD.Interface.CableE
AddInterface=%KSCATEGORY_CAPTURE%,"CableE",MCVAD.Interface.CableE
AddInterface=%KSCATEGORY_REALTIME%,"CableE",MCVAD.Interface.CableE
AddInterface=%KSCATEGORY_TOPOLOGY%,"CableE_Topo_v2",MCVAD.Interface.CableE_Topo

; --- Interface AddReg Sections ---
[MCVAD.Interface.CableA]
AddReg=MCVAD.Interface.CableA.AddReg
[MCVAD.Interface.CableA.AddReg]
HKR,,FriendlyName,,%CableA.Desc%

[MCVAD.Interface.CableA_Topo]
